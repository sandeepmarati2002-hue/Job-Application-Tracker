# Server Configuration
PROJECT_NAME="Job Application Tracker API"
ENVIRONMENT="development"
PORT=8000

# Security & JWT Configuration
SECRET_KEY="replace-with-a-secure-random-64-character-hex-string"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (PostgreSQL)
# Format: postgresql://<username>:<password>@<host>:<port>/<database_name>
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/job_tracker_db"

# Fallback for local quick testing without local PostgreSQL installed:
# DATABASE_URL="sqlite:///./job_tracker.db"

# CORS Allowed Origins (Comma-separated)
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,https://frontend-six-henna-96.vercel.app"
